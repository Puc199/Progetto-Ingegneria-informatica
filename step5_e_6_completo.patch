+<!DOCTYPE html>
+<html lang="it">
+<head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>{% block title %}Pipeline di Parsing Web{% endblock %}</title>
+    <style>
+        /* Foglio di stile unico per tutte le pagine: la consegna chiede
+           HTML e CSS, senza framework che appesantiscano il sistema. */
+        :root {
+            --bg: #f6f7f9;
+            --surface: #ffffff;
+            --border: #dfe3e8;
+            --text: #1c2430;
+            --muted: #5b6673;
+            --accent: #2f5fa8;
+            --ok: #1e7d4f;
+            --ko: #b3261e;
+        }
+        * { box-sizing: border-box; }
+        body {
+            margin: 0;
+            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+            background: var(--bg);
+            color: var(--text);
+            line-height: 1.55;
+        }
+        header {
+            background: var(--surface);
+            border-bottom: 1px solid var(--border);
+            padding: 1rem 1.5rem;
+        }
+        header h1 { margin: 0 0 .6rem; font-size: 1.15rem; }
+        nav a {
+            display: inline-block;
+            margin-right: 1.2rem;
+            color: var(--muted);
+            text-decoration: none;
+            font-size: .92rem;
+            padding-bottom: .2rem;
+            border-bottom: 2px solid transparent;
+        }
+        nav a:hover { color: var(--accent); }
+        nav a.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
+        main { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }
+        h2 { font-size: 1.05rem; margin: 1.6rem 0 .7rem; }
+        h2:first-child { margin-top: 0; }
+        .card {
+            background: var(--surface);
+            border: 1px solid var(--border);
+            border-radius: 8px;
+            padding: 1.1rem 1.25rem;
+            margin-bottom: 1.1rem;
+        }
+        .grid { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
+        label { display: block; font-size: .85rem; color: var(--muted); margin-bottom: .3rem; }
+        input[type=text], input[type=url], select, textarea {
+            width: 100%;
+            padding: .5rem .6rem;
+            border: 1px solid var(--border);
+            border-radius: 5px;
+            font: inherit;
+            font-size: .9rem;
+            background: #fff;
+        }
+        textarea { resize: vertical; font-family: ui-monospace, "SF Mono", Menlo, monospace; }
+        button {
+            padding: .5rem 1rem;
+            border: 1px solid var(--accent);
+            background: var(--accent);
+            color: #fff;
+            border-radius: 5px;
+            font: inherit;
+            font-size: .9rem;
+            cursor: pointer;
+        }
+        button:hover { filter: brightness(1.08); }
+        button.secondary { background: #fff; color: var(--muted); border-color: var(--border); }
+        button.danger { background: #fff; color: var(--ko); border-color: #e6c3c0; }
+        .field { margin-bottom: .9rem; }
+        .row { display: flex; gap: .6rem; align-items: flex-end; flex-wrap: wrap; }
+        .row > .field { flex: 1; min-width: 200px; margin-bottom: 0; }
+        .radios { display: flex; gap: 1.1rem; font-size: .9rem; }
+        .radios label { display: flex; align-items: center; gap: .35rem; color: var(--text); margin: 0; }
+        pre {
+            background: #f2f4f6;
+            border: 1px solid var(--border);
+            border-radius: 5px;
+            padding: .75rem;
+            overflow: auto;
+            max-height: 420px;
+            font-size: .8rem;
+            white-space: pre-wrap;
+            word-break: break-word;
+            margin: 0;
+        }
+        table { width: 100%; border-collapse: collapse; font-size: .88rem; }
+        th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid var(--border); }
+        th { color: var(--muted); font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .02em; }
+        td.num { text-align: right; font-variant-numeric: tabular-nums; }
+        .badge { display: inline-block; padding: .1rem .5rem; border-radius: 999px; font-size: .78rem; font-weight: 600; }
+        .badge.ok { background: #e3f4ea; color: var(--ok); }
+        .badge.ko { background: #fbe9e7; color: var(--ko); }
+        .alert { border-radius: 6px; padding: .7rem .9rem; margin-bottom: 1.1rem; font-size: .9rem; }
+        .alert.error { background: #fbe9e7; border: 1px solid #e6c3c0; color: #8c1d18; }
+        .alert.success { background: #e3f4ea; border: 1px solid #bfe0cd; color: #14603b; }
+        .muted { color: var(--muted); font-size: .85rem; }
+        .url-list li { margin-bottom: .4rem; word-break: break-all; }
+        ul { padding-left: 1.1rem; }
+    </style>
+</head>
+<body>
+<header>
+    <h1>Pipeline di Parsing Web</h1>
+    <nav>
+        <a href="/"               class="{% if active == 'home' %}active{% endif %}">Home</a>
+        <a href="/parser"         class="{% if active == 'parser' %}active{% endif %}">Parser &amp; Evaluation</a>
+        <a href="/gold-standard"  class="{% if active == 'gold' %}active{% endif %}">Gold Standard</a>
+        <a href="/stats"          class="{% if active == 'stats' %}active{% endif %}">Statistiche</a>
+    </nav>
+</header>
+
+<main>
+    {% if error %}<div class="alert error"><strong>Errore.</strong> {{ error }}</div>{% endif %}
+    {% if message %}<div class="alert success">{{ message }}</div>{% endif %}
+    {% block content %}{% endblock %}
+</main>
+</body>
+</html>

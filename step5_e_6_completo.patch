+{% extends "base.html" %}
+{% set active = 'home' %}
+{% block title %}Home - Pipeline di Parsing Web{% endblock %}
+
+{% block content %}
+<div class="card">
+    <p class="muted" style="margin-top:0">
+        Pipeline end-to-end per acquisire pagine web da domini eterogenei, estrarne
+        il testo pulito, valutarne la qualita' con metriche automatiche e con un
+        LLM giudice, e conservare tutto in un database relazionale.
+    </p>
+    <p class="muted" style="margin-bottom:0">
+        <strong>Matricole del gruppo:</strong> {{ matricole }}
+    </p>
+</div>
+
+<div class="grid">
+    <div class="card">
+        <h2>Stato del sistema</h2>
+        <table>
+            <tbody>
+            {% for component in ['backend', 'database', 'ollama'] %}
+                <tr>
+                    <td>{{ component }}</td>
+                    <td style="text-align:right">
+                        {% if status.get(component) == 'ok' %}
+                            <span class="badge ok">ok</span>
+                        {% else %}
+                            <span class="badge ko">error</span>
+                        {% endif %}
+                    </td>
+                </tr>
+            {% endfor %}
+            </tbody>
+        </table>
+        <p class="muted" style="margin-bottom:0">
+            Ollama risulta in errore anche mentre sta ancora scaricando il modello,
+            operazione che al primo avvio richiede diversi minuti.
+        </p>
+    </div>
+
+    <div class="card">
+        <h2>Domini supportati</h2>
+        {% if domains %}
+            <ul class="url-list">
+                {% for domain in domains %}<li>{{ domain }}</li>{% endfor %}
+            </ul>
+        {% else %}
+            <p class="muted">Nessun dominio disponibile: il backend non risponde.</p>
+        {% endif %}
+    </div>
+</div>
+
+<div class="card">
+    <h2>Le tre sezioni</h2>
+    <ul>
+        <li><strong><a href="/parser">Parser &amp; Evaluation</a></strong> — prova un parser su un URL, in modalita' live o usando l'HTML del database, e confronta il risultato con il Gold Standard.</li>
+        <li><strong><a href="/gold-standard">Gold Standard</a></strong> — scarica una pagina, incolla il testo di riferimento estratto a mano e salvali insieme nel database.</li>
+        <li><strong><a href="/stats">Statistiche</a></strong> — conteggi, metriche medie e giudizio medio dell'LLM, per ogni dominio.</li>
+    </ul>
+</div>
+{% endblock %}

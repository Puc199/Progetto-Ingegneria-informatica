--- /dev/null
+++ b/frontend/src/templates/parser.html
@@ -0,0 +1,124 @@
+{% extends "base.html" %}
+{% set active = 'parser' %}
+{% block title %}Parser & Evaluation{% endblock %}
+
+{% block content %}
+<div class="card">
+    <h2>Prova un parser</h2>
+    <form action="/parser" method="post">
+        <div class="field">
+            <label for="url">URL da analizzare</label>
+            <input type="text" id="url" name="url" placeholder="https://en.wikipedia.org/wiki/Minerva"
+                   value="{{ submitted_url or '' }}">
+        </div>
+
+        <div class="field">
+            <label for="gs_url">oppure scegline uno gia' nel Gold Standard</label>
+            <select id="gs_url" name="gs_url">
+                <option value="">— nessuna selezione —</option>
+                {% for url in gs_urls %}
+                    <option value="{{ url }}" {% if url == submitted_url %}selected{% endif %}>{{ url }}</option>
+                {% endfor %}
+            </select>
+        </div>
+
+        <div class="field">
+            <label>Modalita'</label>
+            <div class="radios">
+                <label><input type="radio" name="mode" value="live"
+                              {% if mode != 'local' %}checked{% endif %}> Live — scarica la pagina adesso</label>
+                <label><input type="radio" name="mode" value="local"
+                              {% if mode == 'local' %}checked{% endif %}> Local — usa l'HTML del database</label>
+            </div>
+        </div>
+
+        <button type="submit">Esegui</button>
+        <span class="muted">La modalita' live apre un browser headless: puo' richiedere qualche decina di secondi.</span>
+    </form>
+</div>
+
+{% if parse_result %}
+    <div class="card">
+        <h2>Risultato</h2>
+        <table>
+            <tbody>
+                <tr><th>URL</th><td>{{ parse_result.url }}</td></tr>
+                <tr><th>Dominio</th><td>{{ parse_result.domain }}</td></tr>
+                <tr><th>Titolo</th><td>{{ parse_result.title }}</td></tr>
+                <tr><th>Dimensioni</th>
+                    <td>HTML grezzo {{ parse_result.html_text | length }} caratteri ·
+                        testo estratto {{ parse_result.parsed_text | length }} caratteri</td></tr>
+            </tbody>
+        </table>
+    </div>
+
+    <div class="grid">
+        <div class="card">
+            <h2>html_text (grezzo)</h2>
+            <pre>{{ parse_result.html_text[:20000] }}{% if parse_result.html_text | length > 20000 %}
+
+[... troncato nella visualizzazione, nel database c'e' tutto ...]{% endif %}</pre>
+        </div>
+        <div class="card">
+            <h2>parsed_text (Markdown)</h2>
+            <pre>{{ parse_result.parsed_text }}</pre>
+        </div>
+    </div>
+{% endif %}
+
+{% if gold_result %}
+    <div class="card">
+        <h2>gold_text (riferimento)</h2>
+        <pre>{{ gold_result.gold_text }}</pre>
+    </div>
+{% elif parse_result %}
+    <div class="card">
+        <p class="muted" style="margin:0">
+            Questo URL non e' nel Gold Standard, quindi non ci sono metriche da calcolare.
+            Puoi aggiungerlo dalla pagina <a href="/gold-standard">Gold Standard</a>.
+        </p>
+    </div>
+{% endif %}
+
+{% if eval_result %}
+    <div class="card">
+        <h2>Metriche automatiche</h2>
+        <table>
+            <thead><tr><th>Metrica</th><th class="num">Precision</th><th class="num">Recall</th><th class="num">F1</th></tr></thead>
+            <tbody>
+            {% for name, scores in eval_result.items() %}
+                {% if scores %}
+                <tr>
+                    <td>{{ name }}</td>
+                    <td class="num">{{ '%.3f' | format(scores.precision) }}</td>
+                    <td class="num">{{ '%.3f' | format(scores.recall) }}</td>
+                    <td class="num">{{ '%.3f' | format(scores.f1) }}</td>
+                </tr>
+                {% endif %}
+            {% endfor %}
+            </tbody>
+        </table>
+        <p class="muted" style="margin-bottom:0">
+            <strong>token_level_eval</strong> confronta gli insiemi di token: misura contenuto e rumore,
+            ignora ordine e ripetizioni. <strong>sequence_eval</strong> confronta le sequenze: penalizza
+            i blocchi ripetuti e il testo giusto ma scomposto.
+        </p>
+    </div>
+{% endif %}
+
+{% if judge_result %}
+    <div class="card">
+        <h2>Giudizio dell'LLM</h2>
+        <table>
+            <tbody>
+                <tr><th>Modello</th><td>{{ judge_result.model_name }}</td></tr>
+                <tr><th>Punteggio</th><td><strong>{{ judge_result.judge_score }}</strong> / 5</td></tr>
+                <tr><th>Feedback</th><td>{{ judge_result.judge_feedback }}</td></tr>
+                <tr><th>Formato JSON</th>
+                    <td>{% if judge_result.parse_ok %}<span class="badge ok">rispettato</span>
+                        {% else %}<span class="badge ko">fallback</span>{% endif %}</td></tr>
+            </tbody>
+        </table>
+    </div>
+{% endif %}
+{% endblock %}
diff --git a/frontend/src/templates/stats.html b/frontend/src/templates/stats.html
new file mode 100644
index 0000000..e006abb
--- /dev/null
+++ b/frontend/src/templates/stats.html
@@ -0,0 +1,95 @@
+{% extends "base.html" %}
+{% set active = 'stats' %}
+{% block title %}Statistiche{% endblock %}
+
+{% block content %}
+{% if not stats %}
+    <div class="card"><p class="muted" style="margin:0">Nessuna statistica disponibile.</p></div>
+{% else %}
+<div class="card">
+    <h2>Risorse nel database</h2>
+    <table>
+        <thead><tr><th>Dominio</th><th class="num">web_resources</th><th class="num">gold_standard</th></tr></thead>
+        <tbody>
+        {% for domain in domains %}
+            <tr>
+                <td>{{ domain }}</td>
+                <td class="num">{{ stats.web_resources.get(domain, 0) }}</td>
+                <td class="num">{{ stats.gold_standard.get(domain, 0) }}</td>
+            </tr>
+        {% endfor %}
+        </tbody>
+    </table>
+</div>
+
+<div class="card">
+    <h2>Metriche medie sul Gold Standard</h2>
+    <table>
+        <thead><tr><th>Dominio</th><th>Metrica</th><th class="num">Precision</th><th class="num">Recall</th><th class="num">F1</th></tr></thead>
+        <tbody>
+        {% for domain in domains %}
+            {% set metrics = stats.avg_eval.get(domain, {}) %}
+            {% if metrics %}
+                {% for name, scores in metrics.items() %}
+                <tr>
+                    <td>{% if loop.first %}{{ domain }}{% endif %}</td>
+                    <td>{{ name }}</td>
+                    <td class="num">{{ '%.3f' | format(scores.get('precision', 0)) }}</td>
+                    <td class="num">{{ '%.3f' | format(scores.get('recall', 0)) }}</td>
+                    <td class="num">{{ '%.3f' | format(scores.get('f1', 0)) }}</td>
+                </tr>
+                {% endfor %}
+            {% else %}
+                <tr><td>{{ domain }}</td><td colspan="4" class="muted">nessuna valutazione</td></tr>
+            {% endif %}
+        {% endfor %}
+        </tbody>
+    </table>
+    <p class="muted" style="margin-bottom:0">
+        Soglie di riferimento per l'F1 di token_level_eval: sotto 0.60 scarso,
+        fra 0.60 e 0.80 medio, sopra 0.80 buono.
+    </p>
+</div>
+
+<div class="card">
+    <h2>Giudizio medio dell'LLM</h2>
+    <table>
+        <thead><tr><th>Dominio</th><th class="num">judge_score</th><th class="num">Entry giudicate</th><th class="num">JSON validi</th></tr></thead>
+        <tbody>
+        {% for domain in domains %}
+            {% set judge = stats.avg_eval_judge.get(domain, {}) %}
+            <tr>
+                <td>{{ domain }}</td>
+                <td class="num">{{ '%.2f' | format(judge.get('judge_score', 0)) }} / 5</td>
+                <td class="num">{{ judge.get('judged_entries', 0) | int }}</td>
+                <td class="num">{{ '%.0f%%' | format(judge.get('valid_json_ratio', 0) * 100) }}</td>
+            </tr>
+        {% endfor %}
+        </tbody>
+    </table>
+    <p class="muted" style="margin-bottom:0">
+        "JSON validi" e' la quota di risposte in cui il modello ha rispettato il formato
+        richiesto senza ricorrere al fallback: dice quanto ci si puo' fidare della media
+        a sinistra. I giudizi vengono precalcolati in background all'avvio, quindi subito
+        dopo l'accensione il conteggio puo' essere ancora parziale.
+    </p>
+</div>
+{% endif %}
+
+{% if schema %}
+<div class="card">
+    <h2>Schema del database</h2>
+    {% for table, columns in schema.items() %}
+        <h2 style="font-size:.92rem">{{ table }}</h2>
+        <table style="margin-bottom:1rem">
+            <thead><tr><th>Colonna</th><th>Tipo e chiavi</th></tr></thead>
+            <tbody>
+            {% for column, definition in columns.items() %}
+                <tr><td>{{ column }}</td><td class="muted">{{ definition }}</td></tr>
+            {% endfor %}
+            </tbody>
+        </table>
+    {% endfor %}
+</div>
+{% endif %}
+{% endblock %}
diff --git a/mariadb_data/Dockerfile b/mariadb_data/Dockerfile
new file mode 100644
index 0000000..082d040
--- /dev/null
+++ b/mariadb_data/Dockerfile
@@ -0,0 +1,22 @@
+# Immagine di MariaDB con lo schema del progetto gia' incorporato.
+#
+# init.sql viene copiato in /docker-entrypoint-initdb.d/, che l'immagine
+# ufficiale esegue automaticamente alla prima creazione del data directory.
+#
+# Perche' copiarlo invece di montarlo come volume: montare un singolo file su
+# Docker Desktop per Windows richiede la condivisione del disco e si comporta
+# in modo meno prevedibile del resto. Cosi' il compose non ha piu' nessun bind
+# mount, e il progetto si comporta identico su Windows, macOS e Linux.
+#
+# Nota: qui non si tocca l'utente dell'immagine e non si normalizzano i fine
+# riga. Per MariaDB il ritorno a capo e' spazio bianco come un altro, quindi
+# un init.sql con CRLF viene eseguito correttamente; e cambiare USER
+# rischierebbe di rompere l'entrypoint ufficiale, che ha bisogno dei propri
+# privilegi per preparare il data directory. Il caso resta comunque coperto da
+# .gitattributes, che impone LF a questo file.
+
+FROM mariadb:11.7.2-ubi9
+
+COPY init.sql /docker-entrypoint-initdb.d/01-init.sql
+
+EXPOSE 3306
diff --git a/ollama_data/Dockerfile b/ollama_data/Dockerfile
new file mode 100644
index 0000000..7958e1a
--- /dev/null
+++ b/ollama_data/Dockerfile
@@ -0,0 +1,20 @@
+# Immagine di Ollama con l'entrypoint del progetto gia' incorporato.
+#
+# Perche' non montare semplicemente lo script come volume: su Windows il file
+# puo' arrivare con i fine riga CRLF, e /bin/sh dentro il container fallisce.
+# Copiandolo in fase di build possiamo normalizzarlo qui, una volta per tutte,
+# senza dipendere dalla configurazione git di chi costruisce l'immagine.
+# In piu' si evita del tutto il bind mount di un singolo file, che su Docker
+# Desktop richiede la condivisione del disco ed e' una fonte di attrito in meno.
+
+FROM ollama/ollama:latest
+
+COPY entrypoint.sh /entrypoint.sh
+
+# Rimuove eventuali \r e rende lo script eseguibile: cosi' funziona anche se
+# arriva da un checkout Windows o da uno zip che ha perso i permessi.
+RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh
+
+EXPOSE 11434
+
+ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]

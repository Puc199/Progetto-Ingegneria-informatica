eader center\" >Misc.</th> <th></th> </tr> <tr> <th aria-label=\"Rk\" data-stat=\"ranker\" scope=\"col\" class=\"ranker poptip center\" data-tip=\"Rank\" >Rk</th> <th aria-label=\"Player\" data-stat=\"name_display\" scope=\"col\" class=\" poptip sort_default_asc center\" >Player</th> <th aria-label=\"Age\" data-stat=\"age\" scope=\"col\" class=\" poptip center\" data-tip=\"Player's age on January 31 of the season\" >Age</th> <th aria-label=\"Pos\" data-stat=\"pos\" scope=\"col\" class=\" poptip center\" data-tip=\"Position\" >Pos</th> <th aria-label=\"G\" data-stat=\"games\" scope=\"col\" class=\" poptip center\" data-tip=\"Games\" >G</th> <th aria-label=\"GS\" data-stat=\"games_started\" scope=\"col\" class=\" poptip center\" data-tip=\"Games Started\" >GS</th> <th aria-label=\"MP\" data-stat=\"mp\" scope=\"col\" class=\" poptip center\" data-tip=\"Minutes Played\" >MP</th> <th aria-label=\"PG%\" data-stat=\"pct_1\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at PG\" >PG%</th> <th aria-label=\"SG%\" data-stat=\"pct_2\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at SG\" >SG%</th> <th aria-label=\"SF%\" data-stat=\"pct_3\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at SF\" >SF%</th> <th aria-label=\"PF%\" data-stat=\"pct_4\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at PF\" >PF%</th> <th aria-label=\"C%\" data-stat=\"pct_5\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at C\" >C%</th> <th aria-label=\"OnCourt\" data-stat=\"plus_minus_on\" scope=\"col\" class=\" poptip hide_non_quals right\" data-tip=\"Plus/Minus Per 100 Possessions (On Court)\" data-filter=\"1\" data-name=\"\" >OnCourt</th> <th aria-label=\"On-Off\" data-stat=\"plus_minus_net\" scope=\"col\" class=\" poptip hide_non_quals right\" data-tip=\"Plus/Minus Net Per 100 Possessions\" data-filter=\"1\" data-name=\"\" >
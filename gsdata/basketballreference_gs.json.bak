        \n            \n<div id=\"all_totals_stats\" class=\"table_wrapper tabbed setup_commented commented\">\n\t\n\t\t<span class=\"section_anchor\" id=\"totals_stats_link\" data-label=\"Totals\"></span>\n\t<div class=\"placeholder\"></div>\n<!--\n\n\n<div class=\"section_heading assoc_totals_stats\" id=\"totals_stats_sh\">\n  <span class=\"section_anchor\" id=\"totals_stats_link\" data-label=\"Totals\" data-no-inpage=\"1\"></span><h2>Totals</h2>\n  <div>&#10024;<a href=\"https://www.sports-reference.com/blog/2024/08/upgraded-stats-tables-rolling-out-across-sports-reference/\">Upgraded</a>&#10024;</div>    <div class=\"section_heading_text\">\n      <ul>\n      </ul>\n    </div>\n    \n    \t\t\n</div>\n\t\n\t\n\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\n\t\n\t\n<div class=\"filter switcher\" data-controls=\"#switcher_totals_stats\">\n\n<div class=\" current\">\n\t<a class=\"sr_preset\" data-hide=\"#all_totals_stats .section_heading,  #all_totals_stats .footer,  #all_totals_stats .topscroll_div\" data-show=\".assoc_totals_stats, #tfooter_totals_stats\">Regular Season</a>\n</div></div>\n\n\n\n\t<div class=\"table_container tabbed current\" id=\"div_totals_stats\">\n\t\t\n\t\t<table class=\"stats_table sortable soc\" id=\"totals_stats\" data-cols-to-freeze=\",2\"data-soc-sum-scope-type=\"player_season\"data-soc-sum-phase-type=\"reg\"data-soc-sum-params=\"null\"data-soc-sum-year=\"2026\"> <caption>Totals Table</caption> <colgroup><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col></colgroup> <thead> <tr> <th aria-label=\"Rk\" data-stat=\"ranker\" scope=\"col\" class=\"ranker poptip center\" data-tip=\"Rank\" >Rk</th> <th aria-label=\"Player\" data-stat=\"name_display\" scope=\"col\" class=\" poptip sort_default_asc center\" >Player</th> <th aria-label=\"Age\" data-stat=\"age\" scope=\"col\" class=\" poptip center\" data-tip=\"Player's age on January 31 of the season\" >Age</t
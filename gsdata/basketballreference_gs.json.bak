tion_heading_text\">\n      <ul>\n      </ul>\n    </div>\n    \n    \t\t\n</div>\n\n\n<div class=\"section_heading hidden assoc_advanced_post\" id=\"advanced_post_sh\">\n  <span class=\"section_anchor\" id=\"advanced_post_link\" data-label=\"Advanced\" data-no-inpage=\"1\"></span><h2>Advanced</h2>\n  <div>&#10024;<a href=\"https://www.sports-reference.com/blog/2024/08/upgraded-stats-tables-rolling-out-across-sports-reference/\">Upgraded</a>&#10024;</div>    <div class=\"section_heading_text\">\n      <ul>\n      </ul>\n    </div>\n    \n    \t\t\n</div>\n\t\n\t\n\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\n\t\n\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\n\t\n\t\n<div class=\"filter switcher\" data-controls=\"#switcher_advanced\">\n\n<div class=\" current\">\n\t<a class=\"sr_preset\" data-hide=\"#all_advanced .section_heading,  #all_advanced .footer,  #all_advanced .topscroll_div\" data-show=\".assoc_advanced, #tfooter_advanced\">Regular Season</a>\n</div><div class=\"\">\n\t<a class=\"sr_preset\" data-hide=\"#all_advanced .section_heading,  #all_advanced .footer,  #all_advanced .topscroll_div\" data-show=\".assoc_advanced_post, #tfooter_advanced_post\">Playoffs</a>\n</div></div>\n\n<div id=\"switcher_advanced\">\n\n\t<div class=\"table_container tabbed current\" id=\"div_advanced\">\n\t\t\n\t\t<table class=\"stats_table sortable row_summable suppress_headers soc\" id=\"advanced\" data-cols-to-freeze=\"1,3\"data-soc-sum-scope-type=\"player_season\"data-soc-sum-phase-type=\"reg\"data-soc-sum-table-type=\"Advanced\"data-soc-sum-entity-id=\"jamesle01\"data-soc-sum-params=\"null\"> <caption>Advanced Table</caption> <colgroup><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col></colgroup> <thead> <tr> <th aria-label=\"Season\" data-stat=\"year_id\" scope=\"col\" class=\" poptip center\" >Season</th> <th aria-label=\"Age\" data-stat=\"age\" scope=\"col\" class=\" poptip center\" data-tip=\"Player's age on January 31 of the season\" >Age</th> <th aria-label=\"Team\" data-stat=\"team_name_abbr\" scope=\"col\" class=\" poptip sort_default_asc center\" >Team</th> <th aria-label=\"Lg\" data-stat=\"comp_name_abbr\" scope=\"col\" class=\" poptip sort_default_asc center\" >Lg</th> <th aria-label=\"Pos\" data-stat=\"pos\" scope=\"col\" class=\" poptip center\" data-tip=\"Position\" >Pos</th> <th aria-label=\"G\" data-stat=\"games\" scope=\"col\" class=\" poptip center\" data-tip=\"Games\" >G</th> <th aria-label=\"GS\" data-stat=\"games_started\" scope=\"col\" class=\" poptip center\" data-tip=\"Games Started\" >GS</th> <th aria-label=\"MP\" data-stat=\"mp\" scope=\"col\" class=\" poptip center\" data-tip=\"Minutes Played\" >MP</th> <th aria-label=\"PER\" data-stat=\"per\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Player Efficiency Rating</b><br>A measure of per-minute production standardized such that the league average is 15.\" data-filter=\"1\" data-name=\"\" >PER</th> <th aria-label=\"TS%\" data-stat=\"ts_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<strong>True Shooting Percentage</strong><br>A measure of shooting efficiency that takes into account 2-point field goals, 3-point field goals, and free throws.\" data-filter=\"1\" data-name=\"\" >TS%</th> <th aria-label=\"3PAr\" data-stat=\"fg3a_per_fga_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<strong>3-Point Attempt Rate</strong><br>Percentage of FG Attempts from 3-Point Range\" data-filter=\"1\" data-name=\"\" >3PAr</th> <th aria-label=\"FTr\" data-stat=\"fta_per_fga_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<strong>Free Throw Attempt Rate</strong><br>Number of FT Attempts Per FG Attempt\" data-filter=\"1\" data-name=\"\" >FTr</th> <th aria-label=\"ORB%\" data-stat=\"orb_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Offensive Rebound Percentage</b><br>An estimate of the percentage of available offensive rebounds a player grabbed while they were on the floor.\" data-filter=\"1\" data-name=\"\" >ORB%</th> <th aria-label=\"DRB%\" data-stat=\"drb_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Defensive Rebound Percentage</b><br>An estimate of the percentage of available defensive rebounds a player grabbed while they were on the floor.\" data-filter=\"1\" data-name=\"\" >DRB%</th> <th aria-label=\"TRB%\" data-stat=\"trb_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Total Rebound Percentage</b><br>An estimate of the percentage of available rebounds a player grabbed while they were on the floor.\" data-filter=\"1\" data-name=\"\" >TRB%</th> <th aria-label=\"AST%\" data-stat=\"ast_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Assist Percentage</b><br>An estimate of the percentage of teammate field goals a player assisted while they were on the floor.\" data-filter=\"1\" data-name=\"\" >AST%</th> <th aria-label=\"STL%\" data-stat=\"stl_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Steal Percentage</b><br>An estimate of the percentage of opponent possessions that end with a steal by the player while they were on the floor.\" data-filter=\"1\" data-name=\"\" >STL%</th> <th aria-label=\"BLK%\" data-stat=\"blk_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Block Percentage</b><br>An estimate of the percentage of opponent two-point field goal attempts blocked by the player while they were on the floor.\" data-filter=\"1\" data-name=\"\" >BLK%</th> <th aria-label=\"TOV%\" data-stat=\"tov_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Turnover Percentage</b><br>An estimate of turnovers committed per 100 plays.\" data-filter=\"1\" data-name=\"\" >TOV%</th> <th aria-label=\"USG%\" data-stat=\"usg_pct\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Usage Percentage</b><br>An estimate of the percentage of team plays used by a player while they were on the floor.\" data-filter=\"1\" data-name=\"\" >USG%</th> <th aria-label=\"OWS\" data-stat=\"ows\" scope=\"col\" class=\" poptip center\" data-tip=\"<b>Offensive Win Shares</b><br>An estimate of the number of wins contributed by a player due to offense.\" data-filter=\"1\" data-name=\"\" >OWS</th> <th aria-label=\"DWS\" data-stat=\"dws\" scope=\"col\" class=\" poptip center\" data-tip=\"<b>Defensive Win Shares</b><br>An estimate of the number of wins contributed by a player due to defense.\" data-filter=\"1\" data-name=\"\" >DWS</th> <th aria-label=\"WS\" data-stat=\"ws\" scope=\"col\" class=\" poptip center\" data-tip=\"<b>Win Shares</b><br>An estimate of the number of wins contributed by a player.\" data-filter=\"1\" data-name=\"\" >WS</th> <th aria-label=\"WS/48\" data-stat=\"ws_per_48\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Win Shares Per 48 Minutes</b><br>An estimate of the number of wins contributed by a player per 48 minutes (league average is approximately .100)\" data-filter=\"1\" data-name=\"\" >WS/48</th> <th aria-label=\"OBPM\" data-stat=\"obpm\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Offensive Box Plus/Minus</b><br>A box score estimate of the offensive points per 100 possessions a player contributed above a league-average player, translated to an average team.\" data-filter=\"1\" data-name=\"\" >OBPM</th> <th aria-label=\"DBPM\" data-stat=\"dbpm\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Defensive Box Plus/Minus</b><br>A box score estimate of the defensive points per 100 possessions a player contributed above a league-average player, translated to an average team.\" data-filter=\"1\" data-name=\"\" >DBPM</th> <th aria-label=\"BPM\" data-stat=\"bpm\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"<b>Box Plus/Minus</b><br>A box score estimate of the points per 100 possessions a player contributed above a league-average player, translated to an average team.\" data-filter=\"1\" data-name=\"\" >BPM</th> <th aria-label=\"VORP\" data-stat=\"vorp\" scope=\"col\" class=\" poptip center\" data-tip=\"<b>Value over Replacement Player</b><br>A box score estimate of the points per 100 TEAM possessions that a player contributed above a replacement-level (-2.0) player, translated to an average team and prorated to an 82-game season.<br><br>Multiply by 2.70 to convert to wins over replacement.\" data-filter=\"1\" data-name=\"\" >VORP</th> <th aria-label=\"Awards\" data-stat=\"awards\" scope=\"col\" class=\" poptip sort_default_asc center\" >Awards</th> </tr> </thead> <tbody><tr id=\"advanced.2004\" > <th scope=\"row\" class=\"left \" data-stat=\"year_id\" csk=\"2004\" ><a href=\"/players/j/jamesle01/gamelog/2004/\">2003-04</a></th> <td class=\"right \" data-stat=\"age\" >19</td> <td class=\"left \" data-stat=\"team_name_abbr\" ><a href=\"/teams/CLE/2004.html\">CLE</a></td> <td class=\"left \" data-stat=\"comp_name_abbr\" ><a href=\"/leagues/NBA_2004.html\">NBA</a></td> <td class=\"center \" data-stat=\"pos\" >SG</td> <td class=\"right \" data-stat=\"games\" >79</td> <td class=\"right \" data-stat=\"games_started\" >79</td> <td class=\"right \" data-stat=\"mp\" >3122</td> <td class=\"right \" data-stat=\"per\" csk=\"18.3231900000000000\" >18.3</td> <td class=\"right \" data-stat=\"ts_pct\" csk=\"0.4880783758\" >.488</td> <td class=\"right \" data-stat=\"fg3a_per_fga_pct\" csk=\"0.1454423592\" >.145</td> <td class=\"right \" data-stat=\"fta_per_fga_pct\" csk=\"0.3083109920\" >.308</td> <td class=\"right \" data-stat=\"orb_pct\" csk=\"0.035046530000000000\" >3.5</td> <td class=\"right \" data-stat=\"drb_pct\" csk=\"0.117982280000000000\" >11.8</td> <td class=\"right \" data-stat=\"trb_pct\" csk=\"0.076497080000000000\" >7.6</td> <td class=\"right \" data-stat=\"ast_pct\" csk=\"0.277566160000000000\" >27.8</td> <td class=\"right \" data-stat=\"stl_pct\" 
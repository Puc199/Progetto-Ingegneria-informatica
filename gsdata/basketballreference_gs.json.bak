" >+/- Per 100 Poss</th> <th aria-label=\"Turnovers\" data-stat=\"header_turnovers\" colspan=\"2\" class=\" poptip over_header center\" >Turnovers</th> <th aria-label=\"Fouls Committed\" data-stat=\"header_fouls\" colspan=\"2\" class=\" poptip over_header center\" >Fouls Committed</th> <th aria-label=\"Fouls Drawn\" data-stat=\"header_drawn\" colspan=\"2\" class=\" poptip over_header center\" >Fouls Drawn</th> <th aria-label=\"Misc.\" data-stat=\"header_misc2\" colspan=\"3\" class=\" poptip over_header center\" >Misc.</th> <th></th> </tr> <tr> <th aria-label=\"Season\" data-stat=\"year_id\" scope=\"col\" class=\" poptip center\" >Season</th> <th aria-label=\"Age\" data-stat=\"age\" scope=\"col\" class=\" poptip center\" data-tip=\"Player's age on January 31 of the season\" >Age</th> <th aria-label=\"Team\" data-stat=\"team_name_abbr\" scope=\"col\" class=\" poptip sort_default_asc center\" >Team</th> <th aria-label=\"Lg\" data-stat=\"comp_name_abbr\" scope=\"col\" class=\" poptip sort_default_asc center\" >Lg</th> <th aria-label=\"Pos\" data-stat=\"pos\" scope=\"col\" class=\" poptip center\" data-tip=\"Position\" >Pos</th> <th aria-label=\"G\" data-stat=\"games\" scope=\"col\" class=\" poptip center\" data-tip=\"Games\" >G</th> <th aria-label=\"GS\" data-stat=\"games_started\" scope=\"col\" class=\" poptip center\" data-tip=\"Games Started\" >GS</th> <th aria-label=\"MP\" data-stat=\"mp\" scope=\"col\" class=\" poptip center\" data-tip=\"Minutes Played\" >MP</th> <th aria-label=\"PG%\" data-stat=\"pct_1\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at PG\" >PG%</th> <th aria-label=\"SG%\" data-stat=\"pct_2\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at SG\" >SG%</th> <th aria-label=\"SF%\" data-stat=\"pct_3\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Percentage of MP at SF\" >SF%</th> <th aria-label=\"PF%\" data-stat=\"pct_4\" scope=\"col\" class=\" poptip hide_non_
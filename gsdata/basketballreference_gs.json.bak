\">Upgraded</a>&#10024;</div>    <div class=\"section_heading_text\">\n      <ul>\n      </ul>\n    </div>\n    \n    \t\t\n</div>\n\t\n\t\n\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\t\n\t\n\t\n\t\n<div class=\"filter switcher\" data-controls=\"#switcher_per_poss\">\n\n<div class=\" current\">\n\t<a class=\"sr_preset\" data-hide=\"#all_per_poss .section_heading,  #all_per_poss .footer,  #all_per_poss .topscroll_div\" data-show=\".assoc_per_poss, #tfooter_per_poss\">Regular Season</a>\n</div></div>\n\n\n\n\t<div class=\"table_container tabbed current\" id=\"div_per_poss\">\n\t\t\n\t\t<table class=\"stats_table sortable soc\" id=\"per_poss\" data-cols-to-freeze=\",2\"data-soc-sum-scope-type=\"player_season\"data-soc-sum-phase-type=\"reg\"data-soc-sum-params=\"null\"data-soc-sum-year=\"2026\"> <caption>Per 100 Poss Table</caption> <colgroup><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col><col></colgroup> <thead> <tr> <th aria-label=\"Rk\" data-stat=\"ranker\" scope=\"col\" class=\"ranker poptip center\" data-tip=\"Rank\" >Rk</th> <th aria-label=\"Player\" data-stat=\"name_display\" scope=\"col\" class=\" poptip sort_default_asc center\" >Player</th> <th aria-label=\"Age\" data-stat=\"age\" scope=\"col\" class=\" poptip center\" data-tip=\"Player's age on January 31 of the season\" >Age</th> <th aria-label=\"G\" data-stat=\"games\" scope=\"col\" class=\" poptip center\" data-tip=\"Games\" >G</th> <th aria-label=\"GS\" data-stat=\"games_started\" scope=\"col\" class=\" poptip center\" data-tip=\"Games Started\" >GS</th> <th aria-label=\"MP\" data-stat=\"mp\" scope=\"col\" class=\" poptip center\" data-tip=\"Minutes Played\" >MP</th> <th aria-label=\"FG\" data-stat=\"fg_per_poss\" scope=\"col\" class=\" poptip hide_non_quals center\" data-tip=\"Field Goals\" data-filter=\"1\" data-name=\"\" >FG</th> <th aria-label=\"FGA\" data-stat=\"fga_per_poss\" scope=\"col\" class=\" poptip hide_